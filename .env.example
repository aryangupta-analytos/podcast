# ─── Database ────────────────────────────────────────────────────────────────
# Local dev uses the Postgres in docker-compose.yml (`pnpm db:up`).
# Production: paste the connection string from Neon / Supabase / RDS.
DATABASE_URL=postgres://svtech:svtech_dev_password@localhost:55432/svtech_podcast

# ─── Site ────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321

# ─── Auth ────────────────────────────────────────────────────────────────────
# Signs admin session cookies. MUST be a long random string and MUST be
# different in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# ─── Media storage ───────────────────────────────────────────────────────────
# "local"  — files land in ./storage/uploads and are served by the app.
#            Fine for development; not for production on serverless hosts.
# "s3"     — any S3-compatible bucket (Cloudflare R2, AWS S3, Supabase,
#            Backblaze B2, MinIO). Set the S3_* vars below.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads

# S3_PUBLIC_URL is the CDN/base URL files are served from, e.g.
# https://media.svtechpodcast.com or https://pub-xxx.r2.dev
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Upload limits (bytes). Audio 500 MB, images 10 MB.
MAX_AUDIO_BYTES=524288000
MAX_IMAGE_BYTES=10485760

# ─── Contact form (optional) ────────────────────────────────────────────────
# Contact submissions are always stored in the database and shown in the admin
# panel. If set, they are also forwarded to this Discord webhook.
DISCORD_WEBHOOK=

# Contact submissions can also be copied into a Google Sheet through an Apps
# Script web app (deployed as "Anyone" can access). The secret must match the
# SECRET constant in that script. Leave both empty to skip it.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
