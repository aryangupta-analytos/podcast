---
import SmartImage from '../SmartImage.astro';

export interface Props {
  heading: string;
  body: string;
  imageUrl?: string | null;
}

const { heading, body, imageUrl } = Astro.props;
---

{
  body && (
    <section class="relative z-10 px-8 py-12 lg:px-18" aria-labelledby="about-heading">
      <h2 id="about-heading" class="section-heading-underlined mb-8">
        {heading}
      </h2>

      <div class="flex flex-col gap-8 lg:flex-row">
        {imageUrl && (
          <SmartImage
            class="h-48 w-48 shrink-0 rounded-xl object-cover"
            src={imageUrl}
            alt=""
            width={192}
            height={192}
          />
        )}
        <div class="cms-prose" set:html={body} />
      </div>

      <a
        class="animated-bottom-border text-light-text-heading mt-8 inline-block font-bold after:mt-2 dark:text-white"
        href="/about"
      >
        Read more about the show
      </a>
    </section>
  )
}
