---
import Section from '../site/Section.astro';

/**
 * The closing colour band: the owner's call-to-action headline and copy on
 * the left, the show's headline numbers on the right, and a button through
 * to the About page.
 */
export interface Props {
  heading: string;
  body?: string;
  buttonText?: string;
  buttonUrl?: string;
  stats?: { episodes: number; guests: number; since: number | null };
  tone?: 'accent-1' | 'accent-2' | 'accent-3' | 'accent-4';
}

const { heading, body, buttonText, buttonUrl, stats, tone = 'accent-3' } = Astro.props;
const hasButton = Boolean(buttonText && buttonUrl);

const figures = stats
  ? [
      stats.episodes > 0 && { value: String(stats.episodes), label: stats.episodes === 1 ? 'episode' : 'episodes' },
      stats.guests > 0 && { value: String(stats.guests), label: stats.guests === 1 ? 'guest' : 'guests' },
      stats.since && { value: String(stats.since), label: 'on air since' }
    ].filter((f): f is { value: string; label: string } => Boolean(f))
  : [];
---

<Section id="cta" tone={tone}>
  <div class="cta-grid">
    <div class="cta-copy">
      <h2 class="display cta-title">{heading}</h2>
      {body && <p class="cta-body">{body}</p>}
      {
        hasButton && (
          <a class="pill pill-ink cta-button" href={buttonUrl}>
            {buttonText}
          </a>
        )
      }
    </div>

    {
      figures.length > 0 && (
        <div class="cta-side">
          <dl class="cta-stats">
            {figures.map((f) => (
              <div class="cta-stat">
                <dt class="cta-stat-label">{f.label}</dt>
                <dd class="cta-stat-value">{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </div>
</Section>
