---
import type { Person } from '../../server/db/schema';
import PersonTile from '../people/PersonTile.astro';
import TeamRoster from '../people/TeamRoster.astro';
import Section from '../site/Section.astro';

/**
 * Homepage people band: the hosts and team first (photo tiles for those who
 * have one, names for the rest), then the most recent guests.
 */
export interface Props {
  team: Person[];
  guests: Person[];
  heading: string;
}

const { team, guests, heading } = Astro.props;
---

{
  (team.length > 0 || guests.length > 0) && (
    <Section id="people" heading={heading} moreHref="/people" moreLabel="See everyone">
      {team.length > 0 && <TeamRoster people={team} />}

      {guests.length > 0 && (
        <div class:list={[team.length > 0 && 'mt-14 lg:mt-16']}>
          <h3 class="section-heading people-subheading">Recent guests</h3>
          <ul class="guest-grid" role="list">
            {guests.map((person, index) => (
              <li>
                <PersonTile person={person} index={index + 3} eyebrow="Guest" />
              </li>
            ))}
          </ul>
        </div>
      )}
    </Section>
  )
}
