---
import type { SiteSettings } from '../../server/db/schema';
import SmartImage from '../SmartImage.astro';

export interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;

const hasPrimaryCta = Boolean(settings.heroCtaText && settings.heroCtaUrl);
const hasSecondaryCta = Boolean(
  settings.heroSecondaryCtaText && settings.heroSecondaryCtaUrl
);
---

<section class="relative z-10 px-8 pb-12 lg:px-18 lg:pb-16" aria-labelledby="hero-title">
  <div class="flex flex-col gap-8 lg:flex-row lg:items-center">
    <div class="flex-1">
      {
        settings.heroEyebrow && (
          <p class="section-heading text-light-icon dark:text-dark-icon mb-3">
            {settings.heroEyebrow}
          </p>
        )
      }

      <h1
        id="hero-title"
        class="text-light-text-heading text-3xl leading-tight font-bold text-balance lg:text-5xl dark:text-white"
      >
        {settings.heroTitle}
      </h1>

      {
        settings.heroDescription && (
          <p class="mt-5 max-w-2xl text-lg text-pretty">
            {settings.heroDescription}
          </p>
        )
      }

      {
        (hasPrimaryCta || hasSecondaryCta) && (
          <div class="mt-8 flex flex-wrap items-center gap-4">
            {hasPrimaryCta && (
              <a class="btn" href={settings.heroCtaUrl}>
                <span class="text-light-text-heading rounded-full px-8 py-3 text-center text-sm font-bold dark:text-white">
                  {settings.heroCtaText}
                </span>
              </a>
            )}
            {hasSecondaryCta && (
              <a
                class="animated-bottom-border text-light-text-heading font-bold after:mt-2 dark:text-white"
                href={settings.heroSecondaryCtaUrl}
              >
                {settings.heroSecondaryCtaText}
              </a>
            )}
          </div>
        )
      }
    </div>

    {
      settings.heroImageUrl && (
        <div class="hero-media shrink-0">
          {/*
            The hero image is whatever the owner uploads, and for this show it
            is a transparent brand mark. A bare glyph scaled up floats on the
            page and overpowers the copy, so it sits in a contained panel and is
            capped well below the text block's height. `object-contain` keeps
            any aspect ratio — logo, cover art or photo — uncropped.
          */}
          <SmartImage
            class="hero-image"
            src={settings.heroImageUrl}
            alt=""
            width={320}
            height={320}
            sizes="(min-width: 1024px) 200px, (min-width: 640px) 170px, 45vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>
</section>
