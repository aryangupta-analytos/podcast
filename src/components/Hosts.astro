---
import type { Person } from '../server/db/schema';
import Avatar from './Avatar.astro';

export interface Props {
  hosts: Person[];
  heading?: string;
}

const { hosts, heading = 'Hosted By' } = Astro.props;
---

{
  hosts.length > 0 && (
    <div class="bg-light-card dark:bg-dark-card mx-2 mt-2 rounded-lg px-4 pt-12 pb-12 sm:px-6 md:px-4 lg:mx-0 lg:mt-0 lg:px-16 lg:pb-0">
      <h3 class="section-heading pb-6">{heading}</h3>

      {hosts.map((host) => (
        <a class="mb-4 flex items-center" href={`/people/${host.slug}`}>
          <Avatar
            class="mr-4 h-12 w-12 rounded-lg object-cover"
            name={host.name}
            imageUrl={host.imageUrl}
            placeholder={host.placeholder as 'monogram'}
            size={48}
            loading="eager"
          />
          <span>
            {host.name}
            {host.title && (
              <span class="block text-xs opacity-70">{host.title}</span>
            )}
          </span>
        </a>
      ))}
    </div>
  )
}
