---

{
  links.length > 0 && (
    <ul class:list={['flex flex-wrap items-center gap-1', className]}>
      {links.map((link) => {
        const path = PATHS[link.platform.toLowerCase()];
        return (
          <li>
            <a
              class="text-light-icon dark:text-dark-icon hover:text-light-text-heading inline-flex h-11 w-11 items-center justify-center rounded-md transition-colors hover:bg-black/5 dark:hover:bg-white/10 dark:hover:text-white"
              href={link.url}
              rel="noopener noreferrer me"
              target="_blank"
              aria-label={link.label}
              title={link.label}
            >
              {path ? (
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={path} />
                </svg>
              ) : (
                <span class="px-2 text-xs font-bold underline">{link.label}</span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  )
}
