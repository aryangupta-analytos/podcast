---
import type { LinkRow } from '../server/db/schema';
import { ICON_PATHS as PATHS } from '../lib/icon-paths';

export interface Props {
  links: LinkRow[];
  class?: string;
}

const { links, class: className = '' } = Astro.props;

---
{
  links.length > 0 && (
    <ul class:list={['flex flex-wrap items-center gap-1', className]}>
      {links.map((link) => {
        const path = PATHS[link.platform.toLowerCase()];
        return (
          <li>
            <a
              class="text-text hover:text-heading inline-flex h-11 w-11 items-center justify-center rounded-full transition-colors hover:bg-white/10"
              href={link.url}
              rel="noopener noreferrer me"
              target="_blank"
              aria-label={link.label}
              title={link.label}
            >
              {path ? (
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={path} />
                </svg>
              ) : (
                <span class="px-2 text-xs font-bold underline">{link.label}</span>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  )
}
