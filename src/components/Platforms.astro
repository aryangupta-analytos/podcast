---
import type { LinkRow } from '../server/db/schema';

export interface Props {
  platforms: LinkRow[];
  showTitle: string;
}

const { platforms, showTitle } = Astro.props;

/** Platform keys that have a mask icon in the stylesheet below. */
const ICONS = new Set(['spotify', 'apple', 'overcast', 'pocket-casts', 'youtube']);

const iconKey = (platform: string) =>
  platform.toLowerCase().replace(/[^a-z]/g, '-').replace(/-+/g, '-');
---

{
  platforms.length > 0 && (
    <>
      <h3 class="section-heading hidden pt-12 pb-6 lg:block">Listen</h3>

      <div class="mt-16 flex flex-wrap items-center justify-center gap-6 lg:mt-0 lg:justify-start">
        {platforms.map((link) => {
          const key = iconKey(link.platform);
          return ICONS.has(key) ? (
            <a
              class:list={['gradient-icon', key, key === 'youtube' ? 'h-7 w-7' : 'h-6 w-6']}
              href={link.url}
              rel="noopener noreferrer"
              target="_blank"
              aria-label={`Listen to ${showTitle} on ${link.label}.`}
            />
          ) : (
            <a
              class="text-light-text-heading inline-flex min-h-6 items-center px-1 text-xs font-bold underline hover:no-underline dark:text-white"
              href={link.url}
              rel="noopener noreferrer"
              target="_blank"
            >
              {link.label}
            </a>
          );
        })}
      </div>
    </>
  )
}

<style>
  .apple {
    mask-image: url('../assets/apple.svg');
  }
  .overcast {
    mask-image: url('../assets/overcast.svg');
  }
  .pocket-casts {
    mask-image: url('../assets/pocket-casts.svg');
  }
  .spotify {
    mask-image: url('../assets/spotify.svg');
  }
  .youtube {
    mask-image: url('../assets/youtube.svg');
  }
</style>
