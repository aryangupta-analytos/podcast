---
import { ICON_PATHS, type IconName } from './icons';

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
const d = ICON_PATHS[name];
---

<svg
  class:list={['ic', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} />
</svg>

<style>
  .ic {
    flex: none;
    /* Optically centres a 24-grid icon against a text baseline. */
    vertical-align: -0.14em;
  }
</style>
