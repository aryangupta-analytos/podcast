---
import { ICON_PATHS } from '../../lib/icon-paths';
import type { LinkRow } from '../../server/db/schema';

export interface Props {
  platforms: LinkRow[];
  showTitle: string;
  size?: 'sm' | 'lg';
  /** Show the platform name beside the icon. */
  withLabels?: boolean;
  /** Icons on a dark background. */
  dark?: boolean;
  class?: string;
}

const {
  platforms,
  showTitle,
  size = 'sm',
  withLabels = false,
  dark = false,
  class: className = ''
} = Astro.props;

const key = (platform: string) => platform.toLowerCase().replace(/[^a-z]/g, '');

// Real brand colours so the platform marks read as the actual logos, not a
// flat green. Anything unlisted keeps the inherited colour.
const BRAND: Record<string, string> = {
  apple: '#A855F7',
  applepodcasts: '#A855F7',
  podbean: '#FF6D00',
  youtube: '#FF0000',
  spotify: '#1DB954',
  amazonmusic: '#00A8E1',
  overcast: '#FC7E0F',
  rss: '#F26522'
};
const dim = size === 'lg' ? 'h-6 w-6' : 'h-5 w-5';
---

{
  platforms.length > 0 && (
    <ul class:list={['flex flex-wrap items-center gap-2', className]}>
      {platforms.map((link) => {
        const path = ICON_PATHS[key(link.platform)];
        return (
          <li>
            <a
              class:list={["platform-chip", dark && "platform-chip-dark"]}
              href={link.url}
              rel="noopener noreferrer"
              target="_blank"
              aria-label={`Listen to ${showTitle} on ${link.label}`}
              title={link.label}
            >
              {path ? (
                <svg class={dim} viewBox="0 0 24 24" fill="currentColor" style={BRAND[key(link.platform)] ? `color:${BRAND[key(link.platform)]}` : undefined} aria-hidden="true">
                  <path d={path} />
                </svg>
              ) : (
                <span class="text-xs font-bold">{link.label}</span>
              )}
              {withLabels && path && <span class="text-sm font-semibold">{link.label}</span>}
            </a>
          </li>
        );
      })}
    </ul>
  )
}
