---
export interface Props {
  class?: string;
  /** A narrower measure for long-form reading. */
  narrow?: boolean;
}

const { class: className = '', narrow = false } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full px-5 sm:px-8 lg:px-10',
    narrow ? 'max-w-3xl' : 'max-w-[1600px]',
    className
  ]}
>
  <slot />
</div>
