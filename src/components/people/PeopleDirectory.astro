---
import type { Person } from '../../server/db/schema';
import PersonTile from './PersonTile.astro';
import TeamRoster from './TeamRoster.astro';

/**
 * The People page body: hosts and team as a roster (photo tiles for those
 * with a picture, names for the rest), then every guest as a colour tile.
 * `/people#team` and `/people#guests` still land on the right block.
 */
export interface Props {
  hosts: Person[];
  team: Person[];
  guests: Person[];
  labels?: { team?: string; guests?: string };
}

const { hosts, team, guests, labels = {} } = Astro.props;
const crew = [...hosts, ...team];
---

<div class="people-directory">
  {
    crew.length > 0 && (
      <section id="team" class="people-block" aria-labelledby="people-team-heading">
        <h2 id="people-team-heading" class="display team-heading">
          {labels.team ?? 'Hosts & team'}
        </h2>
        <TeamRoster people={crew} />
      </section>
    )
  }

  {
    guests.length > 0 && (
      <section id="guests" class="people-block" aria-labelledby="people-guests-heading">
        <h2 id="people-guests-heading" class="section-heading people-subheading">
          {labels.guests ?? 'Guests'}
          <span class="people-count">{guests.length}</span>
        </h2>
        <ul class="guest-grid" role="list">
          {guests.map((person, index) => (
            <li>
              <PersonTile person={person} index={index + 3} eyebrow="Guest" />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    crew.length === 0 && guests.length === 0 && (
      <p class="text-text-muted py-10 text-center">No one to show yet. Check back soon!</p>
    )
  }
</div>
