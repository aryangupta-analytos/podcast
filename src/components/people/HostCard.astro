---
import Avatar from '../Avatar.astro';

/**
 * A wide colour-blocked card for a host: eyebrow, serif name, role and a bio
 * link on the left, the photo anchored to the bottom-right and cropped into
 * the block rather than sitting in it as a thumbnail.
 */
export interface Props {
  person: {
    slug: string;
    name: string;
    title?: string | null;
    imageUrl?: string | null;
    placeholder?: string | null;
  };
  index?: number;
  eyebrow?: string;
}

const { person, index = 0, eyebrow = 'Show host' } = Astro.props;
const accent = (index % 6) + 1;
---

<article class="host-card" style={`--host-bg: var(--brand-accent-${accent})`}>
  <div class="host-card-copy">
    <p class="section-heading">{eyebrow}</p>
    <h3 class="host-card-name">{person.name}</h3>
    {person.title && <p class="host-card-role">{person.title}</p>}
    <a class="pill pill-ink mt-6 self-start" href={`/people/${person.slug}`}>
      See full bio
    </a>
  </div>
  <a class="host-card-media" href={`/people/${person.slug}`} aria-hidden="true" tabindex="-1">
    <Avatar
      name={person.name}
      imageUrl={person.imageUrl}
      placeholder={(person.placeholder ?? 'monogram') as 'monogram'}
      size={360}
    />
  </a>
</article>
