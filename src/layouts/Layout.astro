---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { Schema } from 'astro-seo-schema';
import SpeedInsights from '@vercel/speed-insights/astro';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import Player from '../components/Player';
import SearchDialog from '../components/SearchDialog';
import AnnouncementBar from '../components/site/AnnouncementBar.astro';
import Container from '../components/site/Container.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import { isHexColor } from '../lib/colors';

import { getLayoutData } from '../server/repo/layout';

import '../styles/global.css';

export interface Props {
  /** Overrides the canonical URL when a page is reachable at several paths. */
  canonicalURL?: URL;
  description?: string;
  imageUrl?: string;
  title: string;
  /** Hides the breadcrumb bar (the homepage sets this). */
  hideBreadcrumbs?: boolean;
  /** Adds `noindex` — used by pages that must never be in search results. */
  noindex?: boolean;
}

const {
  imageUrl,
  title,
  hideBreadcrumbs = false,
  noindex = false
} = Astro.props;

// One round trip for everything the shell needs, shared by every page.
const { settings, show, hosts, platforms, socials, navLinks, hasVideos } =
  await getLayoutData();

const canonicalURL =
  Astro.props.canonicalURL ?? new URL(Astro.url.pathname, Astro.site);
const description =
  Astro.props.description || settings.metaDescription || settings.description;
const ogImage = imageUrl ?? settings.ogImageUrl ?? show.image;
const absoluteOgImage = ogImage?.startsWith('http')
  ? ogImage
  : new URL(ogImage ?? '/artwork-placeholder.svg', Astro.site).toString();
const rssFeed = new URL('/rss.xml', Astro.site).toString();
const isHome = Astro.url.pathname === '/';

/*
  The browser tab shows only the first ~25 characters of a title, so the page
  name goes first and the show is reduced to a short tag. The full title is
  kept for search engines and link previews (og:title, twitter:title).
*/
const shortShow = show.title
  .replace(/^the\s+/i, '')
  .replace(/silicon valley/i, 'SV')
  .replace(/\s+podcast$/i, ' Podcast');
const pageName = title.split(' — ')[0].trim();
const tabTitle = isHome ? show.title : `${pageName} | ${shortShow}`;

/*
  The owner's accent colours, applied as custom properties on <html> so they
  win over the defaults in src/styles/theme.css. Only well-formed hex values
  are emitted; anything else falls back to the stylesheet default.
*/
const accentStyle = (
  [
    ['--brand-accent-1', settings.accent1],
    ['--brand-accent-2', settings.accent2],
    ['--brand-accent-3', settings.accent3],
    ['--brand-accent-4', settings.accent4],
    ['--brand-accent-5', settings.accent5],
    ['--brand-accent-6', settings.accent6]
  ] as const
)
  .filter(([, value]) => value && isHexColor(value))
  .map(([name, value]) => `${name}:${value.trim()}`)
  .join(';');

// Speed Insights is served by Vercel's own edge; anywhere else its script 404s
// and the browser logs a MIME-type error on every page. Only render it where it
// can actually work.
const onVercel = Boolean(
  typeof process !== 'undefined' && process.env?.VERCEL
);
---

<!doctype html>
<html lang="en" dir="ltr" style={accentStyle || undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${show.title} podcast feed`}
      href={rssFeed}
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#070b2b" />

    <title>{tabTitle}</title>
    <meta content={description} name="description" />

    <!-- Open Graph -->
    <meta content={canonicalURL} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={absoluteOgImage} property="og:image" />
    <meta content={show.title} property="og:site_name" />

    <!-- Twitter/X -->
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={absoluteOgImage} name="twitter:image" />

    <Font cssVariable="--astro-font-manrope" preload />
    <Font cssVariable="--astro-font-oswald" />

    <Schema
      slot="head"
      item={{
        '@context': 'https://schema.org',
        '@type': 'PodcastSeries',
        name: show.title,
        about: settings.tagline,
        description: show.description,
        url: canonicalURL.toString(),
        webFeed: rssFeed,
        author: {
          '@type': 'Organization',
          name: show.title,
          url: canonicalURL.origin
        },
        publisher: {
          '@type': 'Organization',
          name: show.title,
          url: canonicalURL.origin
        },
        image: absoluteOgImage
      }}
    />

    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="font-sans bg-ink text-text min-h-screen antialiased">
    <!-- Ambient aurora: slow-drifting colour fields behind everything. Pure
         transform animation on blurred blobs, so it stays on the compositor. -->
    <div class="site-aurora" aria-hidden="true">
      <span class="site-aurora-blob is-1"></span>
      <span class="site-aurora-blob is-2"></span>
      <span class="site-aurora-blob is-3"></span>
      <span class="site-aurora-blob is-4"></span>
    </div>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!--
      The header is server-rendered on every request and deliberately NOT
      `transition:persist`ed, so its active link is always right. Do not add
      persist to it.
    -->
    {
      settings.showBanner && settings.bannerText && (
        <AnnouncementBar
          label={settings.bannerLabel}
          text={settings.bannerText}
          buttonText={settings.bannerButtonText}
          buttonUrl={settings.bannerButtonUrl}
        />
      )
    }

    <SiteHeader show={show} logo={settings.logoUrl ?? undefined} platforms={platforms} navLinks={navLinks} hasVideos={hasVideos} />

    <main id="main-content" class="relative">
      {
        !isHome && !hideBreadcrumbs && (
          <Container class="pt-6">
            <Breadcrumbs title={title} />
          </Container>
        )
      }

      <slot />
    </main>

    <SiteFooter
      show={show}
      settings={settings}
      hosts={hosts}
      platforms={platforms}
      socials={socials}
      navLinks={navLinks}
      hasVideos={hasVideos}
    />

    <div id="audio-player">
      <Player client:load transition:persist="player" />
    </div>

    <SearchDialog client:load transition:persist="search-dialog" />
    {onVercel && <SpeedInsights />}

    <!--
      Navigation fallback. `is:inline` on purpose: Astro would otherwise bundle
      this into astro:scripts/page.js, and the whole point is to survive the
      case where a module fails to load.
    -->
    <script is:inline>
      /*
        <ClientRouter /> cancels a link's default action and then dynamically
        imports its router module to perform the navigation itself. If that
        import fails — a chunk that 404s, a dropped connection, a dev server
        that has just re-optimised its dependencies — the default is already
        cancelled and nothing replaces it, so the link silently does nothing.

        This watches for that and completes the navigation the browser would
        have done. It reacts to evidence rather than waiting out a fixed timer,
        because a timer long enough to be safe is long enough to feel broken:
        the page itself renders in under 200ms, so a 1.2s wait was almost all
        of the perceived load time.

          · the router announces itself within ~120ms, or it is not there —
            go immediately
          · it announced itself but its import then rejected — go immediately
          · it announced itself and simply never finished — go at the backstop

        Any of these is cancelled the moment a swap actually begins.
      */
      (function () {
        /*
          A healthy navigation fires, in order: before-preparation (the router
          takes the click), after-preparation (it has fetched the next page),
          before-swap, page-load. A stalled one fires only the first and then
          goes quiet — so each stage gets its own short deadline rather than one
          long catch-all, which is what made a failed click feel like a 2.5s
          page load.
        */
        var TAKES_CLICK_MS = 120;
        // Fetching the next page includes rendering it on the server, which can
        // legitimately take a few seconds on a cold dev server or a slow
        // connection. A slow fetch is not a stall; only silence is.
        var FETCHES_PAGE_MS = 6000;
        var BACKSTOP_MS = 10000;

        var pending = null;

        /*
          Once the router has demonstrably stalled, stop paying the detection
          cost on every subsequent click: for the rest of the session the
          browser is allowed to handle links natively, which is instant. A
          healthy router never sets this, so a working site keeps its view
          transitions and its uninterrupted audio.
        */
        var BROKEN_KEY = 'astro-router-stalled';
        var routerStalled = false;
        try {
          routerStalled = sessionStorage.getItem(BROKEN_KEY) === '1';
        } catch (error) {
          // Private mode or blocked storage: just do the detection each time.
        }

        function markStalled() {
          routerStalled = true;
          try {
            sessionStorage.setItem(BROKEN_KEY, '1');
          } catch (error) {
            /* nothing to do */
          }
        }

        function clear() {
          if (!pending) return;
          clearTimeout(pending.probe);
          clearTimeout(pending.backstop);
          pending = null;
        }

        function go() {
          if (!pending) return;
          var url = pending.url;
          var from = pending.from;
          clear();
          markStalled();
          if (location.href === from) location.assign(url);
        }

        // The router took the click. It now has a short window to actually
        // fetch the page; announcing intent is not progress.
        document.addEventListener('astro:before-preparation', function () {
          if (!pending) return;
          clearTimeout(pending.probe);
          pending.routerAlive = true;
          pending.probe = setTimeout(function () {
            if (pending && !pending.fetchedPage) go();
          }, FETCHES_PAGE_MS);
        });

        // Real progress: the next page is in hand.
        document.addEventListener('astro:after-preparation', function () {
          if (!pending) return;
          pending.fetchedPage = true;
          clearTimeout(pending.probe);
        });

        // A swap is underway, or the page has loaded: the navigation is real.
        document.addEventListener('astro:before-swap', clear);
        document.addEventListener('astro:page-load', clear);

        // The router's own dynamic import failing lands here.
        window.addEventListener('unhandledrejection', function () {
          if (pending) go();
        });

        document.addEventListener(
          'click',
          function (event) {
            if (event.defaultPrevented) return;
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }

            var link = event.target && event.target.closest && event.target.closest('a');
            if (!link || !link.href) return;
            if (link.target && link.target !== '_self') return;
            if (link.hasAttribute('download')) return;

            var target;
            try {
              target = new URL(link.href, location.href);
            } catch (error) {
              return;
            }

            if (target.origin !== location.origin) return;
            // A hash on the current page is not a navigation.
            if (
              target.pathname === location.pathname &&
              target.search === location.search &&
              target.hash
            ) {
              return;
            }

            if (routerStalled) {
              /*
                Keep the click away from the router entirely and let the browser
                navigate as it normally would. Stopping propagation here, in the
                capture phase, means the router's own document-level handler
                never runs and so never cancels the default.
              */
              event.stopPropagation();
              return;
            }

            clear();
            pending = {
              url: target.href,
              from: location.href,
              routerAlive: false,
              fetchedPage: false,
              probe: setTimeout(function () {
                // Nothing from the router by now — it is not going to handle
                // this click.
                if (pending && !pending.routerAlive) go();
              }, TAKES_CLICK_MS),
              backstop: setTimeout(go, BACKSTOP_MS)
            };
          },
          // Capture, so this runs before the router's handler and is not
          // skipped if the router stops propagation.
          true
        );
      })();
    </script>
  </body>
</html>
