---
import AboutCta from '../components/home/AboutCta.astro';
import FeaturedPeople from '../components/home/FeaturedPeople.astro';
import HomeHero from '../components/home/HomeHero.astro';
import LatestEpisodes from '../components/home/LatestEpisodes.astro';
import LatestVideos from '../components/home/LatestVideos.astro';
import NewsletterBand from '../components/home/NewsletterBand.astro';
import SeriesBand from '../components/home/SeriesBand.astro';
import ShowIntro from '../components/home/ShowIntro.astro';
import Reveal from '../components/site/Reveal.astro';
import Layout from '../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../lib/cache';
import {
  getFeaturedEpisode,
  getLatestEpisodes,
  getLatestVideos,
  getShowStats
} from '../server/repo/episodes';
import { listRecentGuests, listTeam } from '../server/repo/people';
import { getLinks, getSettings, getShowInfo } from '../server/repo/settings';
import { countEpisodesBySeries, listSeries } from '../server/repo/series';

const settings = await getSettings();
const show = await getShowInfo();

// Each section is skipped entirely when the owner has switched it off, so we
// never pay for a query whose results are not rendered.
const featured = settings.showFeatured ? await getFeaturedEpisode() : null;

const ctaHeading = settings.ctaHeading || settings.aboutHeading;
const ctaBody = settings.ctaBody || settings.tagline;
const showCta = settings.showCta && Boolean(ctaHeading);

const [latest, platforms, team, guests, videos, allSeries, seriesCounts, stats] = await Promise.all([
  // Only the configured number of episodes — never the whole archive.
  getLatestEpisodes(settings.latestEpisodeCount),
  getLinks('platform'),
  settings.showPeople ? listTeam() : Promise.resolve([]),
  settings.showPeople ? listRecentGuests(8) : Promise.resolve([]),
  settings.showVideos ? getLatestVideos(settings.latestVideoCount) : Promise.resolve([]),
  settings.showSeries ? listSeries() : Promise.resolve([]),
  settings.showSeries ? countEpisodesBySeries() : Promise.resolve(new Map<string, number>()),
  showCta ? getShowStats() : Promise.resolve(undefined)
]);

const title = settings.metaTitle || `${show.title} — ${settings.tagline}`;

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout title={title} description={settings.metaDescription || settings.description} hideBreadcrumbs>
  <!-- The show first: artwork, name, what it is about, where to listen. -->
  <ShowIntro settings={settings} show={show} platforms={platforms} />

  {
    settings.showHero && (
      <div data-reveal>
        <HomeHero settings={settings} show={show} featured={featured} latest={latest} />
      </div>
    )
  }

  <div data-reveal>
    <LatestEpisodes episodes={latest} show={show} heading={settings.latestHeading} layout="spotlight" />
  </div>

  {
    settings.showSeries && (
      <div data-reveal>
        <SeriesBand series={allSeries} counts={seriesCounts} heading={settings.seriesHeading} />
      </div>
    )
  }

  {
    settings.showPeople && (
      <div data-reveal>
        <FeaturedPeople team={team} guests={guests} heading={settings.peopleHeading} />
      </div>
    )
  }

  {
    settings.showVideos && (
      <div data-reveal>
        <LatestVideos episodes={videos} heading={settings.videosHeading} />
      </div>
    )
  }

  {
    settings.showNewsletter && (
      <div data-reveal>
        <NewsletterBand
          heading={settings.newsletterHeading}
          body={settings.newsletterBody}
          buttonText={settings.newsletterButtonText || "Subscribe"}
          showTitle={show.title}
        />
      </div>
    )
  }

  {
    showCta && (
      <div data-reveal>
        <AboutCta
          heading={ctaHeading}
          body={ctaBody}
          buttonText={settings.ctaButtonText || 'Learn more about us'}
          buttonUrl={settings.ctaButtonUrl || '/about'}
          stats={stats}
        />
      </div>
    )
  }

  <Reveal />
</Layout>
