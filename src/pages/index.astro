---
import EpisodeList from '../components/EpisodeList.astro';
import AboutSection from '../components/home/AboutSection.astro';
import FeaturedEpisode from '../components/home/FeaturedEpisode.astro';
import Hero from '../components/home/Hero.astro';
import PersonGrid from '../components/home/PersonGrid.astro';
import Layout from '../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../lib/cache';
import {
  getFeaturedEpisode,
  getLatestEpisodes
} from '../server/repo/episodes';
import { listRecentGuests, listTeam } from '../server/repo/people';
import { getSettings, getShowInfo } from '../server/repo/settings';

const settings = await getSettings();
const show = await getShowInfo();

// Each section is skipped entirely when the owner has switched it off, so we
// never pay for a query whose results are not rendered.
const featured = settings.showFeatured ? await getFeaturedEpisode() : null;

const [latest, team, guests] = await Promise.all([
  // Only the configured number of episodes — never the whole archive.
  getLatestEpisodes(settings.latestEpisodeCount, featured?.id),
  settings.showTeam ? listTeam() : Promise.resolve([]),
  settings.showGuests ? listRecentGuests(8) : Promise.resolve([])
]);

const title = settings.metaTitle || `${show.title} — ${settings.tagline}`;

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout title={title} description={settings.metaDescription || settings.description}>
  {settings.showHero && <Hero settings={settings} />}

  {
    featured && (
      <FeaturedEpisode
        episode={featured}
        show={show}
        heading={settings.featuredHeading}
      />
    )
  }

  <section
    class="relative z-10 px-8 py-12 lg:px-18"
    aria-labelledby="latest-heading"
  >
    <div class="mb-2 flex items-baseline justify-between gap-4">
      <h2 id="latest-heading" class="section-heading">
        {settings.latestHeading}
      </h2>
      <a
        class="text-light-text-heading text-sm font-bold underline hover:no-underline dark:text-white"
        href="/episodes"
      >
        All episodes
      </a>
    </div>

    <EpisodeList episodes={latest} show={show} />
  </section>

  {
    settings.showAbout && (
      <AboutSection
        heading={settings.aboutHeading}
        body={settings.aboutBody}
        imageUrl={settings.aboutImageUrl}
      />
    )
  }

  <PersonGrid people={team} heading={settings.teamHeading} id="team-heading" />

  <PersonGrid
    people={guests}
    heading={settings.guestsHeading}
    id="guests-heading"
  />
</Layout>
