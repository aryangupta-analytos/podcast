---
import ContactForm from '../components/ContactForm';
import Container from '../components/site/Container.astro';
import Layout from '../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../lib/cache';
import { getSettings, getShowInfo } from '../server/repo/settings';
import { getSeriesBySlug } from '../server/repo/series';

const [settings, show] = await Promise.all([getSettings(), getShowInfo()]);

// "/contact?series=manufacturing" opens the form with an invitation to that
// series already written, so a would-be guest only has to add their details.
const seriesSlug = Astro.url.searchParams.get('series');
const invitedTo = seriesSlug ? await getSeriesBySlug(seriesSlug) : null;
const initialMessage = invitedTo
  ? `I would like to be a guest on the ${invitedTo.name} series. Here is a little about me and what I could talk about:

`
  : '';

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout
  title={`${settings.contactHeading} — ${show.title}`}
  description={`Get in touch with ${show.title}.`}
>
  <Container class="pt-10 pb-16 lg:pt-14">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="section-heading text-primary mb-3">Contact</p>
        <h1 class="display text-5xl lg:text-6xl">{settings.contactHeading}</h1>

        {
          settings.contactBody ? (
            <div class="cms-prose mt-6" set:html={settings.contactBody} />
          ) : (
            <p class="text-text mt-6 text-lg">
              Have a question, or a guest you would like to hear from? Send us a
              note and we will be in touch.
            </p>
          )
        }

        {
          (settings.contactEmail || settings.contactPhone) && (
            <ul class="mt-8 space-y-3 text-base">
              {settings.contactEmail && (
                <li>
                  <a class="text-heading font-semibold hover:underline" href={`mailto:${settings.contactEmail}`}>
                    {settings.contactEmail}
                  </a>
                </li>
              )}
              {settings.contactPhone && (
                <li>
                  <a
                    class="text-heading font-semibold hover:underline"
                    href={`tel:${settings.contactPhone.replace(/[^+\d]/g, '')}`}
                  >
                    {settings.contactPhone}
                  </a>
                </li>
              )}
            </ul>
          )
        }
      </div>

      <div class="lg:col-span-7">
        <div class="card p-6 sm:p-8">
          <ContactForm client:load initialMessage={initialMessage} />
        </div>
      </div>
    </div>
  </Container>
</Layout>
