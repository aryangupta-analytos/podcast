---
import ContactForm from '../components/ContactForm';
import Layout from '../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../lib/cache';
import { getSettings, getShowInfo } from '../server/repo/settings';

const [settings, show] = await Promise.all([getSettings(), getShowInfo()]);

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout
  title={`${settings.contactHeading} — ${show.title}`}
  description={`Get in touch with ${show.title}.`}
>
  <div class="relative z-10 px-8 pb-16 lg:px-18">
    <h1
      class="text-light-text-heading mb-4 text-2xl font-bold lg:mb-6 lg:text-5xl dark:text-white"
    >
      {settings.contactHeading}
    </h1>

    {
      settings.contactBody ? (
        <div class="cms-prose mb-8 max-w-2xl" set:html={settings.contactBody} />
      ) : (
        <p class="mb-8 max-w-2xl">
          Have a question, or a guest you would like to hear from? Send us a
          note and we will be in touch.
        </p>
      )
    }

    {
      (settings.contactEmail || settings.contactPhone) && (
        <div class="mb-10 flex flex-wrap gap-6 text-sm">
          {settings.contactEmail && (
            <a
              class="animated-bottom-border text-light-text-heading font-bold after:mt-1 dark:text-white"
              href={`mailto:${settings.contactEmail}`}
            >
              {settings.contactEmail}
            </a>
          )}
          {settings.contactPhone && (
            <a
              class="animated-bottom-border text-light-text-heading font-bold after:mt-1 dark:text-white"
              href={`tel:${settings.contactPhone.replace(/[^+\d]/g, '')}`}
            >
              {settings.contactPhone}
            </a>
          )}
        </div>
      )
    }

    <ContactForm client:load />
  </div>
</Layout>
