---
import ContactForm from '../components/ContactForm';
import Container from '../components/site/Container.astro';
import PlatformIcons from '../components/site/PlatformIcons.astro';
import Reveal from '../components/site/Reveal.astro';
import Layout from '../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../lib/cache';
import { getSeriesBySlug, listSeries } from '../server/repo/series';
import { getLinks, getSettings, getShowInfo } from '../server/repo/settings';

/*
  The contact page: the owner's heading and note, ways to reach the show as
  cards, an invitation to each series, where to listen — and the form. All of
  it comes from site_settings, the series and the platform links.
*/
const [settings, show, allSeries, platforms] = await Promise.all([
  getSettings(),
  getShowInfo(),
  listSeries(),
  getLinks('platform')
]);

// "/contact?series=manufacturing" opens the form with an invitation to that
// series already written, so a would-be guest only has to add their details.
const seriesSlug = Astro.url.searchParams.get('series');
const invitedTo = seriesSlug ? await getSeriesBySlug(seriesSlug) : null;
const initialMessage = invitedTo
  ? `I would like to be a guest on the ${invitedTo.name} series. Here is a little about me and what I could talk about:

`
  : '';

const phoneHref = settings.contactPhone ? `tel:${settings.contactPhone.replace(/[^+\d]/g, '')}` : '';

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout
  title={`${settings.contactHeading} — ${show.title}`}
  description={`Get in touch with ${show.title}.`}
>
  <Container class="pt-10 pb-20 lg:pt-14">
    <div class="contact">
      <header class="contact-head" data-reveal>
        <p class="section-heading text-primary">Contact</p>
        <h1 class="display contact-title">{settings.contactHeading}</h1>
        {
          settings.contactBody ? (
            <div class="contact-note" set:html={settings.contactBody} />
          ) : (
            <p class="contact-note">
              Have a question, or a guest you would like to hear from? Send us a note and we will be in touch.
            </p>
          )
        }
      </header>

      <div class="contact-grid">
        <aside class="contact-side">
          {
            (settings.contactEmail || settings.contactPhone) && (
              <ul class="contact-methods" role="list">
                {settings.contactEmail && (
                  <li>
                    <a class="contact-method" href={`mailto:${settings.contactEmail}`}>
                      <span class="contact-method-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="5" width="18" height="14" rx="2" />
                          <path d="m3 7 9 6 9-6" />
                        </svg>
                      </span>
                      <span class="contact-method-text">
                        <span class="contact-method-label">Email</span>
                        <span class="contact-method-value">{settings.contactEmail}</span>
                      </span>
                      <span class="contact-method-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                )}
                {settings.contactPhone && (
                  <li>
                    <a class="contact-method" href={phoneHref}>
                      <span class="contact-method-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
                        </svg>
                      </span>
                      <span class="contact-method-text">
                        <span class="contact-method-label">Phone</span>
                        <span class="contact-method-value">{settings.contactPhone}</span>
                      </span>
                      <span class="contact-method-arrow" aria-hidden="true">→</span>
                    </a>
                  </li>
                )}
              </ul>
            )
          }

          {
            allSeries.length > 0 && (
              <section class="contact-panel" aria-labelledby="contact-series-heading">
                <h2 id="contact-series-heading" class="section-heading contact-panel-heading">
                  Be a guest on a series
                </h2>
                <ul class="contact-series" role="list">
                  {allSeries.map((item) => (
                    <li>
                      <a
                        href={`/contact?series=${item.slug}#contact-form`}
                        class:list={['contact-series-link', invitedTo?.id === item.id && 'is-active']}
                        aria-current={invitedTo?.id === item.id ? 'true' : undefined}
                      >
                        <span class="contact-series-name">{item.name}</span>
                        {item.tagline && <span class="contact-series-tagline">{item.tagline}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            platforms.length > 0 && (
              <section class="contact-panel" aria-labelledby="contact-listen-heading">
                <h2 id="contact-listen-heading" class="section-heading contact-panel-heading">
                  Listen on
                </h2>
                <PlatformIcons platforms={platforms} showTitle={show.title} size="lg" class="mt-4" />
              </section>
            )
          }
        </aside>

        <div class="contact-form-card" id="contact-form">
          <h2 class="contact-form-title">{invitedTo ? `Be a guest on ${invitedTo.name}` : 'Send us a message'}</h2>
          <div class="mt-6">
            <ContactForm client:load initialMessage={initialMessage} />
          </div>
        </div>
      </div>
    </div>
  </Container>

  <Reveal />
</Layout>
