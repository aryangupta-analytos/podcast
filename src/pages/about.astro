---
import NewsletterBand from '../components/home/NewsletterBand.astro';
import TeamRoster from '../components/people/TeamRoster.astro';
import Container from '../components/site/Container.astro';
import PlatformIcons from '../components/site/PlatformIcons.astro';
import SmartImage from '../components/SmartImage.astro';
import Layout from '../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../lib/cache';
import { listPeople } from '../server/repo/people';
import { getLinks, getSettings, getShowInfo } from '../server/repo/settings';

const [settings, show, hosts, team, platforms] = await Promise.all([
  getSettings(),
  getShowInfo(),
  listPeople('host'),
  listPeople('team'),
  getLinks('platform')
]);

const rssFeed = new URL('/rss.xml', Astro.site).toString();
const artwork = settings.aboutImageUrl ?? show.image;

// The call-to-action copy the owner wrote for the homepage doubles as the
// "about the show" editorial card here; nothing is invented for this page.
const ctaHeading = settings.ctaHeading || settings.aboutHeading;
const ctaBody = settings.ctaBody || settings.description;

// Hosts and team are one roster: the people with a photo get a tile, the
// rest are named. The host cards this page used to open with are gone — the
// same three photos now lead the roster instead.
const crew = [...hosts, ...team];

const hasContact = Boolean(settings.contactEmail || settings.contactPhone || settings.contactBody);

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout
  title={`${settings.aboutTitle} — ${show.title}`}
  description={settings.description}
  hideBreadcrumbs
>
  <!-- Hero: type is the design -->
  <section class="page-hero-band about-hero">
    <Container class="text-center">
      <p class="section-heading text-primary">About</p>
      <h1 class="display about-hero-title">{settings.aboutTitle}</h1>
      {settings.tagline && <p class="about-hero-tagline">{settings.tagline}</p>}
    </Container>
  </section>

  <!-- The show: artwork beside the owner's About copy, on the navy panel -->
  <section class="about-section" aria-labelledby="about-show">
    <Container>
      <div class="about-band">
        <div class="about-band-art">
          <SmartImage
            src={artwork}
            alt=""
            width={420}
            height={420}
            sizes="(min-width: 1024px) 380px, 70vw"
            loading="eager"
          />
        </div>
        <div class="about-band-copy">
          <h2 id="about-show" class="section-heading">About {show.title}</h2>
          {
            settings.aboutBody ? (
              <div class="about-band-prose" set:html={settings.aboutBody} />
            ) : (
              <p class="about-band-prose">{settings.description}</p>
            )
          }
          <PlatformIcons platforms={platforms} showTitle={show.title} size="lg" class="about-band-icons mt-6" />
        </div>
      </div>
    </Container>
  </section>

  <!-- Team -->
  {
    crew.length > 0 && (
      <section class="about-section" aria-labelledby="team-heading">
        <Container>
          <h2 id="team-heading" class="section-heading people-subheading">
            {settings.teamHeading}
          </h2>
          <TeamRoster people={crew} />
        </Container>
      </section>
    )
  }

  <!-- Asymmetric editorial cards: a small card beside a large one -->
  <section class="about-section" aria-label="More about the show">
    <Container>
      <div class="about-grid">
        <div class="about-card about-card-listen">
          <h2 class="section-heading">Where to listen</h2>
          <PlatformIcons
            platforms={platforms}
            showTitle={show.title}
            size="lg"
            withLabels
            class="about-listen-list mt-5"
          />
          <a class="about-listen-rss" href={rssFeed}>
            RSS feed
          </a>
        </div>

        {
          ctaHeading && (
            <div class="about-card about-card-feature">
              <h2 class="display about-card-title">{ctaHeading}</h2>
              {ctaBody && <p class="about-card-body">{ctaBody}</p>}
              <a class="pill pill-ink mt-6 self-start" href="/episodes">
                {settings.heroCtaText || settings.latestHeading}
              </a>
            </div>
          )
        }
      </div>
    </Container>
  </section>

  <!-- Contact: minimal and spacious -->
  {
    hasContact && (
      <section class="about-contact" aria-labelledby="contact-heading">
        <Container class="text-center">
          <h2 id="contact-heading" class="display about-contact-title">
            {settings.contactHeading}
          </h2>
          <p class="about-contact-links">
            {settings.contactEmail && (
              <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>
            )}
            {settings.contactEmail && settings.contactPhone && <span aria-hidden="true"> · </span>}
            {settings.contactPhone && (
              <a href={`tel:${settings.contactPhone.replace(/[^+\d]/g, '')}`}>{settings.contactPhone}</a>
            )}
          </p>
          <a class="pill pill-primary mt-6" href="/contact">
            {settings.contactHeading}
          </a>
        </Container>
      </section>
    )
  }

  {
    settings.showNewsletter && (
      <NewsletterBand
        heading={settings.newsletterHeading}
        body={settings.newsletterBody}
        buttonText={settings.newsletterButtonText || 'Subscribe'}
        showTitle={show.title}
      />
    )
  }
</Layout>
