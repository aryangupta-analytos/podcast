---
import { Schema } from 'astro-seo-schema';

import CreatorsAndGuests from '../../components/episode/CreatorsAndGuests.astro';
import FormattedDate from '../../components/FormattedDate';
import FullPlayButton from '../../components/FullPlayButton';
import PlayButton from '../../components/player/PlayButton';
import Layout from '../../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../../lib/cache';
import { formatDuration } from '../../lib/format';
import {
  getAdjacentEpisodes,
  getEpisodeBySlug
} from '../../server/repo/episodes';
import { listPeople } from '../../server/repo/people';
import { getShowInfo } from '../../server/repo/settings';
import { dasherize } from '../../utils/dasherize';

const { slug } = Astro.params;
const episode = slug ? await getEpisodeBySlug(slug) : null;

if (!episode) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// An episode reachable by number redirects to its slug so there is exactly one
// indexable URL per episode.
if (episode.episodeSlug !== slug) {
  return Astro.redirect(`/episodes/${episode.episodeSlug}`, 301);
}

const [show, hosts, adjacent] = await Promise.all([
  getShowInfo(),
  listPeople('host'),
  getAdjacentEpisodes(episode)
]);

const canonicalURL = new URL(`/episodes/${episode.episodeSlug}`, Astro.site);

const credits = [
  ...hosts.map((host) => ({
    slug: host.slug,
    name: host.name,
    title: host.title,
    imageUrl: host.imageUrl,
    placeholder: host.placeholder,
    isHost: true
  })),
  ...episode.guests.map((guest) => ({
    slug: guest.slug,
    name: guest.name,
    title: guest.title,
    imageUrl: guest.imageUrl,
    placeholder: guest.placeholder,
    isHost: false
  }))
];

const playerEpisode = {
  audio: episode.audio,
  episodeNumber: episode.episodeNumber,
  id: episode.id,
  title: episode.title
};

const title = episode.episodeNumber
  ? `${episode.title} — ${show.title} — Episode ${episode.episodeNumber}`
  : `${episode.title} — ${show.title}`;

const externalLinks = [
  { label: 'Spotify', url: episode.links.spotify },
  { label: 'Apple Podcasts', url: episode.links.apple },
  { label: 'YouTube', url: episode.links.youtube },
  { label: 'Listen elsewhere', url: episode.links.other }
].filter((link): link is { label: string; url: string } => Boolean(link.url));

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout
  canonicalURL={canonicalURL}
  description={episode.description}
  imageUrl={episode.episodeImage ?? show.image}
  title={title}
>
  <Schema
    slot="head"
    item={{
      '@context': 'https://schema.org',
      '@type': 'PodcastEpisode',
      name: episode.title,
      datePublished: new Date(episode.published).toISOString(),
      description: episode.description,
      ...(episode.episodeNumber
        ? { episodeNumber: Number(episode.episodeNumber) }
        : {}),
      url: canonicalURL.toString(),
      image: episode.episodeImage || show.image,
      ...(episode.duration
        ? {
            duration: `PT${Math.floor(episode.duration / 60)}M${episode.duration % 60}S`
          }
        : {}),
      ...(episode.audio.src
        ? {
            associatedMedia: {
              '@type': 'MediaObject',
              contentUrl: episode.audio.src,
              encodingFormat: episode.audio.type
            }
          }
        : {}),
      partOfSeries: {
        '@type': 'PodcastSeries',
        name: show.title,
        url: Astro.site?.toString()
      }
    }}
  />

  {episode.audio.src && <meta slot="head" property="og:audio" content={episode.audio.src} />}
  <meta
    slot="head"
    property="article:published_time"
    content={new Date(episode.published).toISOString()}
  />

  <div class="relative z-10 px-8 lg:px-18">
    <div class="block lg:flex">
      {
        episode.audio.src && (
          <div class="mt-4 mr-11 hidden h-14 w-14 shrink-0 lg:block">
            <PlayButton client:only="preact" episode={playerEpisode} />
          </div>
        )
      }

      <div class="overflow-hidden break-words">
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <FormattedDate date={new Date(episode.published)} />
          {episode.duration > 0 && <span>· {formatDuration(episode.duration)}</span>}
          {episode.season && <span>· Season {episode.season}</span>}
        </div>

        <h1
          class="text-light-text-heading mt-2 mb-4 text-2xl font-bold text-balance lg:mb-6 lg:text-5xl dark:text-white"
          style={'view-transition-name: vt-' + dasherize(episode.title)}
        >
          {episode.episodeNumber && `${episode.episodeNumber}: `}{episode.title}
        </h1>

        {episode.description && <p class="mb-8 text-pretty lg:mb-12">{episode.description}</p>}

        {
          episode.audio.src && (
            <div class="mb-8 block lg:hidden">
              <FullPlayButton client:only="preact" episode={playerEpisode} />
            </div>
          )
        }

        {
          externalLinks.length > 0 && (
            <div class="mb-12 flex flex-wrap gap-6 text-sm">
              {externalLinks.map((link) => (
                <a
                  class="animated-bottom-border text-light-text-heading font-bold after:mt-1 dark:text-white"
                  href={link.url}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {link.label}
                </a>
              ))}
            </div>
          )
        }

        <CreatorsAndGuests people={credits} />

        {
          episode.content && (
            <>
              <h2 class="section-heading-underlined mt-16 mb-8">Show Notes</h2>
              <div class="cms-prose mb-5" set:html={episode.content} />
            </>
          )
        }

        <nav
          class="dark:border-dark-border mt-16 flex flex-col gap-4 border-t pt-8 pb-16 text-sm sm:flex-row sm:justify-between"
          aria-label="More episodes"
        >
          {
            adjacent.older ? (
              <a
                class="text-light-text-heading font-bold underline hover:no-underline dark:text-white"
                href={`/episodes/${adjacent.older.slug}`}
                rel="prev"
              >
                ← {adjacent.older.title}
              </a>
            ) : (
              <span />
            )
          }
          {
            adjacent.newer ? (
              <a
                class="text-light-text-heading text-right font-bold underline hover:no-underline dark:text-white"
                href={`/episodes/${adjacent.newer.slug}`}
                rel="next"
              >
                {adjacent.newer.title} →
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>
    </div>
  </div>
</Layout>
