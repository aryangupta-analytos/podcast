---
import EmptyState from '../../components/EmptyState.astro';
import EpisodeCard from '../../components/episode/EpisodeCard.astro';
import Container from '../../components/site/Container.astro';
import Layout from '../../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../../lib/cache';
import { getPublishedEpisodes } from '../../server/repo/episodes';
import { getSettings, getShowInfo } from '../../server/repo/settings';

const PER_PAGE = 12;

// Pagination keeps the archive at a constant cost no matter how long the show
// runs: page 40 loads exactly as many rows as page 1.
const requested = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page = Number.isFinite(requested) && requested > 0 ? requested : 1;

const [settings, show, episodes] = await Promise.all([
  getSettings(),
  getShowInfo(),
  getPublishedEpisodes({ page, perPage: PER_PAGE })
]);

// A page past the end is a 404, not an empty list — otherwise crawlers index
// endless blank pages.
if (page > episodes.totalPages && episodes.total > 0) {
  return Astro.redirect('/episodes', 302);
}

const title = `Episodes — ${show.title}`;
const canonicalURL = new URL(
  page > 1 ? `/episodes?page=${page}` : '/episodes',
  Astro.site
);
const prevHref = page === 2 ? '/episodes' : `/episodes?page=${page - 1}`;
const nextHref = `/episodes?page=${page + 1}`;

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout
  title={title}
  description={`Every episode of ${show.title}. ${settings.description}`.slice(0, 300)}
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    {page > 1 && <link rel="prev" href={prevHref} />}
    {page < episodes.totalPages && <link rel="next" href={nextHref} />}
  </Fragment>

  <Container class="pt-10 pb-16 lg:pt-14">
    <div class="max-w-3xl">
      <p class="section-heading text-primary mb-3">Podcast</p>
      <h1 class="display text-5xl lg:text-6xl">{settings.episodesHeading || 'Episodes'}</h1>
      {settings.episodesIntro && <p class="text-text mt-4 text-lg">{settings.episodesIntro}</p>}
      <p class="text-text-muted mt-4">
        {episodes.total} episode{episodes.total === 1 ? '' : 's'}
        {episodes.totalPages > 1 && ` · page ${page} of ${episodes.totalPages}`}
      </p>
    </div>

    {
      episodes.items.length === 0 ? (
        <EmptyState message="No episodes yet. Check back soon!" />
      ) : (
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8" role="list">
          {episodes.items.map((episode, index) => (
            <li>
              <EpisodeCard
                episode={episode}
                show={show}
                variant="card"
                index={index}
                loading={index < 3 ? 'eager' : 'lazy'}
              />
            </li>
          ))}
        </ul>
      )
    }

    {
      episodes.totalPages > 1 && (
        <nav class="flex items-center justify-between gap-4 py-12" aria-label="Episode pages">
          {page > 1 ? (
            <a class="pill pill-ghost" href={prevHref} rel="prev">
              ← Newer episodes
            </a>
          ) : (
            <span />
          )}

          {page < episodes.totalPages ? (
            <a class="pill pill-ghost" href={nextHref} rel="next">
              Older episodes →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </Container>
</Layout>
