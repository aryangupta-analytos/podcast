---
import { readFormData } from '../../server/read-form';
import FileUpload from '../../components/admin/FileUpload';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getEpisodeById, listEpisodesForAdmin } from '../../server/repo/episodes';
import { getSettings, updateSettings } from '../../server/repo/settings';
import { normalizeHex } from '../../lib/colors';

const user = Astro.locals.user!;
let errors: string[] = [];

if (Astro.request.method === 'POST') {
  const form = await readFormData(Astro.request);
  const text = (key: string) => String(form.get(key) ?? '').trim();
  const checked = (key: string) => form.get(key) === 'on';

  const latestCount = Number.parseInt(text('latestEpisodeCount'), 10);
  if (!Number.isFinite(latestCount) || latestCount < 1 || latestCount > 24) {
    errors.push('Show between 1 and 24 latest episodes.');
  }

  const videoCount = Number.parseInt(text('latestVideoCount'), 10);
  if (!Number.isFinite(videoCount) || videoCount < 1 || videoCount > 12) {
    errors.push('Show between 1 and 12 latest videos.');
  }

  const accents = (['accent1', 'accent2', 'accent3', 'accent4', 'accent5', 'accent6'] as const).map((key) => {
    const value = normalizeHex(text(key));
    if (!value) errors.push(`Brand colour ${key.slice(-1)} must be a hex colour like #ff6a3d.`);
    return [key, value] as const;
  });

  const featured = text('featuredEpisodeId');

  if (errors.length === 0) {
    await updateSettings({
      showTitle: text('showTitle') || 'Podcast',
      tagline: text('tagline'),
      description: text('description'),
      artworkUrl: text('artworkUrl') || null,

      featuredEpisodeId: featured || null,

      heroTitle: text('heroTitle'),
      heroDescription: text('heroDescription'),
      heroCtaText: text('heroCtaText'),
      heroCtaUrl: text('heroCtaUrl'),

      featuredHeading: text('featuredHeading'),
      latestHeading: text('latestHeading'),

      latestEpisodeCount: latestCount,

      showHero: checked('showHero'),
      showFeatured: checked('showFeatured'),

      showPeople: checked('showPeople'),
      peopleHeading: text('peopleHeading') || 'Guests & Hosts',

      showSeries: checked('showSeries'),
      seriesHeading: text('seriesHeading') || 'Our series',

      showVideos: checked('showVideos'),
      videosHeading: text('videosHeading') || 'Latest Videos',
      latestVideoCount: videoCount,

      showNewsletter: checked('showNewsletter'),
      newsletterHeading: text('newsletterHeading'),
      newsletterBody: text('newsletterBody'),
      newsletterButtonText: text('newsletterButtonText') || 'Subscribe',

      showCta: checked('showCta'),
      ctaHeading: text('ctaHeading'),
      ctaBody: text('ctaBody'),
      ctaButtonText: text('ctaButtonText'),
      ctaButtonUrl: text('ctaButtonUrl'),
      ctaImageUrl: text('ctaImageUrl') || null,

      showBanner: checked('showBanner'),
      bannerLabel: text('bannerLabel'),
      bannerText: text('bannerText'),
      bannerButtonText: text('bannerButtonText'),
      bannerButtonUrl: text('bannerButtonUrl'),

      episodesHeading: text('episodesHeading') || 'Episodes',
      episodesIntro: text('episodesIntro'),
      peopleIntro: text('peopleIntro'),

      ...Object.fromEntries(accents.map(([key, value]) => [key, value!])),

      metaTitle: text('metaTitle'),
      metaDescription: text('metaDescription'),
      ogImageUrl: text('ogImageUrl') || null,
      footerText: text('footerText')
    });

    return Astro.redirect(
      `/admin/homepage?saved=${encodeURIComponent('Homepage updated — the changes are live.')}`,
      303
    );
  }
}

const settings = await getSettings();
const published = await listEpisodesForAdmin({
  page: 1,
  perPage: 100,
  status: 'published'
});

// The dropdown lists the newest 100 episodes; a pinned episode older than that
// must still appear, or the form would silently unpin it on save.
const pinned =
  settings.featuredEpisodeId && !published.items.some((e) => e.id === settings.featuredEpisodeId)
    ? await getEpisodeById(settings.featuredEpisodeId)
    : null;
const featuredOptions = pinned ? [pinned, ...published.items] : published.items;
---

<AdminLayout title="Edit Homepage" user={user}>
  <a class="btn-admin" href="/" target="_blank" rel="noopener" slot="actions">
    View homepage ↗
  </a>

  <form method="POST">
    {
      errors.length > 0 && (
        <div class="admin-flash is-error" role="alert">
          <ul style="margin:0; padding-left:18px">
            {errors.map((message) => (
              <li>{message}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="admin-card">
      <h2>Show identity</h2>
      <p class="hint">Shown in the header and footer on every page of the website.</p>

      <div class="admin-field">
        <label for="showTitle">Podcast name</label>
        <input id="showTitle" name="showTitle" type="text" value={settings.showTitle} required />
      </div>

      <div class="admin-field">
        <label for="tagline">Tagline</label>
        <input id="tagline" name="tagline" type="text" value={settings.tagline} />
        <p class="help">One short line under the name.</p>
      </div>

      <div class="admin-field">
        <label for="description">Show description</label>
        <textarea id="description" name="description" style="min-height:90px">{settings.description}</textarea>
      </div>

      <FileUpload
        client:load
        name="artworkUrl"
        kind="image"
        label="Show artwork"
        help="The square cover art. Used in the header, the RSS feed and social previews."
        value={settings.artworkUrl ?? ''}
      />
    </div>

    <div class="admin-card">
      <h2>Show introduction</h2>
      <p class="hint">
        The opening of the homepage: the artwork, the show's name, what it is
        about and a button to start listening. Leave a field empty to reuse the
        podcast name and description from Show identity above.
      </p>

      <div class="admin-field">
        <label for="heroTitle">Headline</label>
        <input id="heroTitle" name="heroTitle" type="text" value={settings.heroTitle} placeholder={settings.showTitle} />
      </div>

      <div class="admin-field">
        <label for="heroDescription">Introduction</label>
        <textarea id="heroDescription" name="heroDescription" style="min-height:90px" placeholder={settings.description}>{settings.heroDescription}</textarea>
        <p class="help">Two or three sentences on what the show is and who it is for.</p>
      </div>

      <div class="admin-row">
        <div class="admin-field">
          <label for="heroCtaText">Button text</label>
          <input id="heroCtaText" name="heroCtaText" type="text" value={settings.heroCtaText} placeholder={settings.latestHeading} />
        </div>
        <div class="admin-field">
          <label for="heroCtaUrl">Button link</label>
          <input id="heroCtaUrl" name="heroCtaUrl" type="text" value={settings.heroCtaUrl} placeholder="/episodes" />
        </div>
      </div>
    </div>

    <div class="admin-card">
      <h2>Featured episodes carousel</h2>
      <p class="hint">
        The colour cards under the introduction. The first card is the featured
        episode; the rest are the newest episodes. It advances by itself every
        five seconds.
      </p>

      <label class="admin-check">
        <input type="checkbox" name="showHero" checked={settings.showHero} />
        <span>Show the hero carousel</span>
      </label>

      <label class="admin-check">
        <input type="checkbox" name="showFeatured" checked={settings.showFeatured} />
        <span>Lead with a featured episode</span>
      </label>

      <div class="admin-row">
        <div class="admin-field">
          <label for="featuredEpisodeId">Which episode is featured</label>
          <select id="featuredEpisodeId" name="featuredEpisodeId">
            <option value="">Automatic — the episode marked featured, else the newest</option>
            {
              featuredOptions.map((episode) => (
                <option value={episode.id} selected={settings.featuredEpisodeId === episode.id}>
                  {episode.episodeNumber ? `${episode.episodeNumber}. ` : ''}
                  {episode.title}
                </option>
              ))
            }
          </select>
          <p class="help">
            Leave on automatic and the homepage keeps itself current with no work.
          </p>
        </div>
        <div class="admin-field">
          <label for="featuredHeading">Heading above the carousel</label>
          <input id="featuredHeading" name="featuredHeading" type="text" value={settings.featuredHeading} placeholder="Featured episodes" />
        </div>
      </div>
    </div>

    <div class="admin-card">
      <h2>Latest episodes grid</h2>

      <div class="admin-row">
        <div class="admin-field">
          <label for="latestHeading">Heading</label>
          <input id="latestHeading" name="latestHeading" type="text" value={settings.latestHeading} />
        </div>
        <div class="admin-field">
          <label for="latestEpisodeCount">How many episodes</label>
          <input
            id="latestEpisodeCount"
            name="latestEpisodeCount"
            type="number"
            min="1"
            max="24"
            value={settings.latestEpisodeCount}
          />
        </div>
      </div>
    </div>

    <div class="admin-card">
      <h2>People grid</h2>
      <p class="hint">Hosts, team and recent guests as photo tiles on the homepage.</p>

      <label class="admin-check">
        <input type="checkbox" name="showPeople" checked={settings.showPeople} />
        <span>Show the people grid</span>
      </label>

      <div class="admin-field">
        <label for="peopleHeading">Heading</label>
        <input id="peopleHeading" name="peopleHeading" type="text" value={settings.peopleHeading} />
      </div>
    </div>

    <div class="admin-card">
      <h2>Latest videos</h2>
      <p class="hint">
        Episodes that have a YouTube link appear here automatically. Add the link
        on the episode's edit page.
      </p>

      <label class="admin-check">
        <input type="checkbox" name="showVideos" checked={settings.showVideos} />
        <span>Show latest videos</span>
      </label>

      <div class="admin-row">
        <div class="admin-field">
          <label for="videosHeading">Heading</label>
          <input id="videosHeading" name="videosHeading" type="text" value={settings.videosHeading} />
        </div>
        <div class="admin-field">
          <label for="latestVideoCount">How many videos</label>
          <input
            id="latestVideoCount"
            name="latestVideoCount"
            type="number"
            min="1"
            max="12"
            value={settings.latestVideoCount}
          />
        </div>
      </div>
    </div>

    <div class="admin-card">
      <h2>Newsletter signup</h2>
      <p class="hint">
        Addresses are stored under Inbox → Subscribers and can be exported as CSV.
      </p>

      <label class="admin-check">
        <input type="checkbox" name="showNewsletter" checked={settings.showNewsletter} />
        <span>Show the newsletter box</span>
      </label>

      <div class="admin-field">
        <label for="newsletterHeading">Heading</label>
        <input id="newsletterHeading" name="newsletterHeading" type="text" value={settings.newsletterHeading} />
      </div>

      <div class="admin-field">
        <label for="newsletterBody">Text</label>
        <textarea id="newsletterBody" name="newsletterBody" style="min-height:70px">{settings.newsletterBody}</textarea>
      </div>

      <div class="admin-field">
        <label for="newsletterButtonText">Button text</label>
        <input id="newsletterButtonText" name="newsletterButtonText" type="text" value={settings.newsletterButtonText} />
      </div>
    </div>

    <div class="admin-card">
      <h2>Call to action</h2>
      <p class="hint">
        The coloured block near the bottom of the homepage. Left empty, it uses
        the About heading and tagline.
      </p>

      <label class="admin-check">
        <input type="checkbox" name="showCta" checked={settings.showCta} />
        <span>Show the call to action</span>
      </label>

      <div class="admin-field">
        <label for="ctaHeading">Heading</label>
        <input id="ctaHeading" name="ctaHeading" type="text" value={settings.ctaHeading} placeholder={settings.aboutHeading} />
      </div>

      <div class="admin-field">
        <label for="ctaBody">Text</label>
        <textarea id="ctaBody" name="ctaBody" style="min-height:70px">{settings.ctaBody}</textarea>
      </div>

      <div class="admin-row">
        <div class="admin-field">
          <label for="ctaButtonText">Button text</label>
          <input id="ctaButtonText" name="ctaButtonText" type="text" value={settings.ctaButtonText} placeholder="Learn more about us" />
        </div>
        <div class="admin-field">
          <label for="ctaButtonUrl">Button link</label>
          <input id="ctaButtonUrl" name="ctaButtonUrl" type="text" value={settings.ctaButtonUrl} placeholder="/about" />
        </div>
      </div>

      <FileUpload
        client:load
        name="ctaImageUrl"
        kind="image"
        label="Image"
        help="Optional. Falls back to the About image."
        value={settings.ctaImageUrl ?? ''}
      />
    </div>

    <div class="admin-card">
      <h2>Announcement banner</h2>
      <p class="hint">
        The light strip above the header on every page. Visitors can close it;
        it stays closed for the rest of their visit. Leave the text empty to hide it.
      </p>

      <label class="admin-check">
        <input type="checkbox" name="showBanner" checked={settings.showBanner} />
        <span>Show the banner</span>
      </label>

      <div class="admin-row">
        <div class="admin-field">
          <label for="bannerLabel">Bold label</label>
          <input id="bannerLabel" name="bannerLabel" type="text" value={settings.bannerLabel} placeholder="NEW EPISODE:" />
        </div>
        <div class="admin-field">
          <label for="bannerText">Text</label>
          <input id="bannerText" name="bannerText" type="text" value={settings.bannerText} />
        </div>
      </div>

      <div class="admin-row">
        <div class="admin-field">
          <label for="bannerButtonText">Button text</label>
          <input id="bannerButtonText" name="bannerButtonText" type="text" value={settings.bannerButtonText} placeholder="Listen now" />
        </div>
        <div class="admin-field">
          <label for="bannerButtonUrl">Button link</label>
          <input id="bannerButtonUrl" name="bannerButtonUrl" type="text" value={settings.bannerButtonUrl} placeholder="/episodes" />
        </div>
      </div>
    </div>

    <div class="admin-card">
      <h2>Series band</h2>
      <p class="hint">The row of series cards on the homepage. The series themselves are edited under Series.</p>
      <label class="admin-check">
        <input type="checkbox" name="showSeries" checked={settings.showSeries} />
        <span>Show the series band</span>
      </label>
      <div class="admin-field">
        <label for="seriesHeading">Heading</label>
        <input id="seriesHeading" name="seriesHeading" type="text" value={settings.seriesHeading} />
      </div>
    </div>

    <div class="admin-card">
      <h2>Episodes and People pages</h2>
      <p class="hint">The heading and short introduction at the top of each page.</p>

      <div class="admin-row">
        <div class="admin-field">
          <label for="episodesHeading">Episodes page heading</label>
          <input id="episodesHeading" name="episodesHeading" type="text" value={settings.episodesHeading} />
        </div>
        <div class="admin-field">
          <label for="episodesIntro">Episodes page introduction</label>
          <input id="episodesIntro" name="episodesIntro" type="text" value={settings.episodesIntro} />
        </div>
      </div>

      <div class="admin-field">
        <label for="peopleIntro">People page introduction</label>
        <input id="peopleIntro" name="peopleIntro" type="text" value={settings.peopleIntro} />
        <p class="hint">The People page heading is the “Guests &amp; Hosts” heading above.</p>
      </div>
    </div>

    <div class="admin-card">
      <h2>Brand colours</h2>
      <p class="hint">
        The six accent colours used in turn for the hero cards, episode tiles,
        people tiles and series. The navy background and text colours are fixed
        so everything stays readable.
      </p>

      <div class="admin-row">
        {
          (['accent1', 'accent2', 'accent3', 'accent4', 'accent5', 'accent6'] as const).map((key, i) => (
            <div class="admin-field">
              <label for={key}>Accent {i + 1}</label>
              <input id={key} name={key} type="color" value={settings[key]} style="height:44px; padding:4px; width:100%" />
            </div>
          ))
        }
      </div>
    </div>

    <div class="admin-card">
      <h2>Search engines and sharing</h2>

      <div class="admin-field">
        <label for="metaTitle">Browser tab / search result title</label>
        <input id="metaTitle" name="metaTitle" type="text" value={settings.metaTitle} />
      </div>

      <div class="admin-field">
        <label for="metaDescription">Search result description</label>
        <textarea id="metaDescription" name="metaDescription" style="min-height:70px" maxlength="320">{settings.metaDescription}</textarea>
        <p class="help">Around 150–160 characters reads best in Google.</p>
      </div>

      <FileUpload
        client:load
        name="ogImageUrl"
        kind="image"
        label="Social sharing image"
        help="Shown when someone shares the site on LinkedIn, X or Facebook."
        value={settings.ogImageUrl ?? ''}
      />

      <div class="admin-field">
        <label for="footerText">Footer text</label>
        <input id="footerText" name="footerText" type="text" value={settings.footerText} />
      </div>
    </div>

    <div class="admin-actions is-sticky">
      <button class="btn-admin is-primary" type="submit">Save homepage</button>
      <a class="btn-admin" href="/admin">Cancel</a>
    </div>
  </form>
</AdminLayout>
