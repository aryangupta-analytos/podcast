---
import PeopleDirectory from '../../components/people/PeopleDirectory.astro';
import Container from '../../components/site/Container.astro';
import Layout from '../../layouts/Layout.astro';
import { CACHE_PUBLIC_PAGE } from '../../lib/cache';
import { listPeople, listRecentGuests } from '../../server/repo/people';
import { getSettings, getShowInfo } from '../../server/repo/settings';

const [settings, show, hosts, team, guests] = await Promise.all([
  getSettings(),
  getShowInfo(),
  listPeople('host'),
  listPeople('team'),
  listRecentGuests(200)
]);

const heading = settings.peopleHeading || 'Guests & Hosts';

Astro.response.headers.set('Cache-Control', CACHE_PUBLIC_PAGE);
---

<Layout
  title={`${heading} — ${show.title}`}
  description={`The hosts, team and guests of ${show.title}.`}
  hideBreadcrumbs
>
  <section class="page-hero-band about-hero">
    <Container class="text-center">
      <p class="section-heading text-primary">People</p>
      <h1 class="display about-hero-title">{heading}</h1>
      {settings.peopleIntro && <p class="about-hero-tagline people-hero-lede">{settings.peopleIntro}</p>}
    </Container>
  </section>

  <Container class="pb-20 lg:pb-28">
    <PeopleDirectory
      hosts={hosts}
      team={team}
      guests={guests}
      labels={{ team: settings.teamHeading || 'Hosts & team', guests: 'Guests' }}
    />
  </Container>
</Layout>
