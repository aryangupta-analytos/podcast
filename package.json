{
  "name": "svtechpodcast",
  "version": "1.0.0",
  "private": true,
  "description": "The Silicon Valley Tech Podcast — public site + admin CMS",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "media:prune": "tsx scripts/prune-media.ts",
    "build:node": "node scripts/build-node.mjs",
    "preview:prod": "node scripts/preview-prod.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^5.1.4",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^10.0.8",
    "@aws-sdk/client-s3": "^3.703.0",
    "@aws-sdk/lib-storage": "^3.703.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@preact/signals": "^2.9.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/speed-insights": "^1.3.1",
    "astro": "6.4.2",
    "astro-seo-schema": "^5.2.0",
    "atropos": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "html-to-text": "^9.0.5",
    "postgres": "^3.4.5",
    "preact": "^10.29.2",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/node": "^10.1.4",
    "@eslint/js": "^9.39.4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.12.4",
    "@typescript-eslint/parser": "^8.60.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "esbuild",
      "sharp"
    ]
  }
}
